# Database
DB_PATH=data/dissonance.db

# Default backend for every tier: "ollama" for local dev, "nebius" for Token Factory (final demo)
LLM_PROVIDER=ollama
# Optional per-tier override: spend credits on one tier only, e.g.
# PROVIDER_ULTRA=nebius

# Tier -> concrete model ID. Swapping backends is a config change only.
# Local stand-ins (Ollama). For the final demo, set LLM_PROVIDER=nebius and the
# Nemotron 3 Nano / Super / Ultra IDs from the Token Factory console.
MODEL_NANO=nemotron-3-nano:4b
MODEL_SUPER=nemotron-3-nano:30b
MODEL_ULTRA=deepseek-r1:32b

# Context window (tokens) for tiers on Token Factory; Ollama tiers report their own.
# CTX_ULTRA=262144

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Nebius Token Factory (OpenAI-compatible endpoint; confirm base URL + model IDs in the console)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# Tavily (bonus prize: sourcing dimension)
TAVILY_API_KEY=

# Database
DB_PATH=data/dissonance.db

# Default backend for every tier: "ollama" for local dev, "nebius" for Token Factory (final demo)
LLM_PROVIDER=ollama
# Optional per-tier override: spend credits on one tier only, e.g.
# PROVIDER_ULTRA=nebius

# Tier -> concrete model ID. Swapping backends is a config change only.
# Local stand-ins (Ollama). For the final demo, set LLM_PROVIDER=nebius and the
# Nemotron 3 Nano / Super / Ultra IDs from the Token Factory console.
MODEL_NANO=nemotron-3-nano:4b
MODEL_SUPER=nemotron-3-nano:30b
MODEL_ULTRA=deepseek-r1:32b

# Context window (tokens) for tiers on Token Factory; Ollama tiers report their own.
# CTX_ULTRA=262144

# Thinking per tier (on | off). Default: off for Nano and Super, on for Ultra.
# REASONING_NANO=off
# REASONING_ULTRA=on

# Who reads messages for style requests: nano (Nemotron Nano, keywords as fallback) or keywords
SIGNAL_EXTRACTOR=nano

# Past conversations (Memory): compressed files here, deleted after N days unless kept
# MEMORY_DIR=data/memory
MEMORY_RETENTION_DAYS=10

# Public demo mode for a hosted link: private random session ids, per-IP rate limit,
# output caps and a daily spend cut-off.
PUBLIC_DEMO=0
# RATE_LIMIT_PER_MIN=6
# DAILY_BUDGET_USD=1.00
# MAX_TOKENS_ULTRA=4000

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Nebius Token Factory (OpenAI-compatible endpoint; confirm base URL + model IDs in the console)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily (bonus prize: sourcing dimension)
TAVILY_API_KEY=
